      "versionNonce": 9729500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "\u2022 No implicit memory \u2014 all knowledge encoded in ROLES, SKILLS, STORIES",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 No implicit memory \u2014 all knowledge encoded in ROLES, SKILLS, STORIES",
      "lineHeight": 1.25
    },
    {
      "id": "9EjHvIHCtlRJoWcURYxP",
      "type": "text",
      "x": 1485,
      "y": 498,
      "width": 1045,
      "height": 23.55,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2551904,
      "version": 2,
      "versionNonce": 8310236,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Teams are fallible; COUNCIL catches individual errors via consensus",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Teams are fallible; COUNCIL catches individual errors via consensus",
      "lineHeight": 1.25
    },
    {
      "id": "7h7ug0g4ai18eWqMyeuP",
      "type": "text",
      "x": 1485,
      "y": 538,
      "width": 1045,
      "height": 23.55,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 8952697,
      "version": 2,
      "versionNonce": 6375500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Consensus of 1 = HIGH RISK  |  Consensus of N = TRUSTED OUTCOME",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Consensus of 1 = HIGH RISK  |  Consensus of N = TRUSTED OUTCOME",
      "lineHeight": 1.25
    },
    {
      "id": "7M3EHMoQrof8VRgksbud",
      "type": "text",
      "x": 1485,
      "y": 578,
      "width": 1045,
      "height": 23.55,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 6014017,
      "version": 2,
      "versionNonce": 6288790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Nonlinearity embraced \u2014 any ROLE can talk to any ROLE at any time",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Nonlinearity embraced \u2014 any ROLE can talk to any ROLE at any time",
      "lineHeight": 1.25
    },
    {
