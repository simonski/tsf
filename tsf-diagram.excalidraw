    },
    {
      "id": "TLboP1KbVYJVkGBr9BY8",
      "type": "text",
      "x": 1000,
      "y": 458,
      "width": 380,
      "height": 216.60000000000002,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 7885466,
      "version": 2,
      "versionNonce": 5837818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Assembly of appropriate ROLEs\nthat evaluates work quality\nthrough consensus.\n\n\u2192 Moves work forward  (OK)\n\u2192 Sends back for rework  (NOT OK)\n\u2192 Escalates to HUMAN if no\n   consensus is achievable\n\nMitigates hallucinations:\nindividual errors caught\nby the collective judgment",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assembly of appropriate ROLEs\nthat evaluates work quality\nthrough consensus.\n\n\u2192 Moves work forward  (OK)\n\u2192 Sends back for rework  (NOT OK)\n\u2192 Escalates to HUMAN if no\n   consensus is achievable\n\nMitigates hallucinations:\nindividual errors caught\nby the collective judgment",
      "lineHeight": 1.25
    },
