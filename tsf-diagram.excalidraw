    },
    {
      "id": "5sRzDDCilLUieV0vWqaT",
      "type": "text",
      "x": 1485,
      "y": 458,
      "width": 1045,
      "height": 23.55,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
