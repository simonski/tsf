      "versionNonce": 9857818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Institutional knowledge (the 'Sally problem') encoded in ROLE descriptions",
