# tsf Environment Variables
# Copy this file to .env and update with your values

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Orchestrator credentials
ORCHESTRATOR_USERNAME=orchestrator
ORCHESTRATOR_PASSWORD=changeme456

# Worker credentials (for multiple workers, add more entries)
WORKER1_USERNAME=worker1
WORKER1_PASSWORD=changeme789

# Server configuration
SF_URL=http://localhost:8080
SF_DB_PATH=./data/task.db

# Optional: JWT Secret (auto-generated if not set)
# JWT_SECRET=your-secret-key-here

# Optional: Logging level
# LOG_LEVEL=info
